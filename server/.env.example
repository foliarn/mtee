# Copy this file to `.env` in the folder that holds compose.yaml, then fill it in.

# The MTEE account whose music folder is mounted (also the folder name under /music).
ADMIN_USER=
# Absolute path on this host to the admin's music folder. It is adopted in place, not copied.
MUSIC_DIR=
# Host folder for the database, backups and upload parts. Make it owned by UID:GID.
DATA_DIR=./data
# Public address of the server, for example https://remote.example.com. Leave empty if none.
PUBLIC_URL=
# Address that the reverse proxy has when it connects to the container. Empty means 127.0.0.1.
TRUSTED_PROXIES=
# Host port. The server listens on 127.0.0.1 only.
PORT=8080
# Owner of the music files: the output of `id -u` and `id -g` on this host.
UID=1000
GID=1000
# Name of the external Docker network of the reverse proxy. Only with the proxy block in compose.yaml.
PROXY_NETWORK=
